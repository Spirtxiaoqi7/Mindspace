{
  "name": "mindspace-desktop",
  "version": "0.9.0",
  "description": "Mindspace local AI desktop application",
  "author": "Mindspace",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prebuild": "node sync-runtime-assets.cjs",
    "check": "tsc --noEmit",
    "test": "node --test *.test.cjs",
    "build:companion": "vite build --config companion/vite.config.ts",
    "build": "npm run check && vite build",
    "dev": "vite",
    "electron": "electron .",
    "predist": "node prepare-bootstrap.cjs",
    "dist": "npm run build && electron-builder --win dir",
    "prepackage:app": "node prepare-bootstrap.cjs",
    "package:app": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "electron-updater": "6.8.9",
    "extract-zip": "2.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "8.1.5"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "com.mindspace.desktop",
    "productName": "Mindspace",
    "directories": {
      "output": "../dist-launcher"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "!assets/brand/**/*",
      "!assets/live2d/**/*",
      "!assets/companion-renderer/**/*",
      "main.cjs",
      "preload.cjs",
      "update-manager.cjs",
      "launcher-updater.cjs",
      "component-manager.cjs",
      "diagnostics-controller.cjs",
      "environment-registry.cjs",
      "gpt-sovits-catalog.cjs",
      "runtime-manager.cjs",
      "runtime-controller.cjs",
      "hardware-policy.cjs",
      "service-policy.cjs",
      "onboarding-policy.cjs",
      "onboarding-controller.cjs",
      "qwen-runtime-policy.cjs",
      "qwen-controller.cjs",
      "process-check.cjs",
      "announcement-policy.cjs",
      "companion-policy.cjs",
      "companion-controller.cjs",
      "app-paths.cjs",
      "storage-location.cjs",
      "storage-controller.cjs",
      "bootstrap-core.cjs",
      "external-navigation.cjs",
      "secret-store.cjs",
      "service-supervisor.cjs",
      "settings-controller.cjs",
      "product-windows.cjs",
      "update-controller.cjs",
      "service-ports.cjs",
      "voice-controller.cjs",
      "root-hint.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bootstrap/mindspace-core.zip",
        "to": "bootstrap/mindspace-core.zip"
      },
      {
        "from": "bootstrap/manifest.json",
        "to": "bootstrap/manifest.json"
      },
      {
        "from": "assets/runtime-manifest.json",
        "to": "runtime/runtime-manifest.json"
      },
      {
        "from": "../config/service-ports.json",
        "to": "config/service-ports.json"
      },
      {
        "from": "bootstrap/runtime-bundle/uv",
        "to": "runtime/bundled/uv"
      },
      {
        "from": "bootstrap/runtime-bundle/powershell",
        "to": "runtime/bundled/powershell"
      },
      {
        "from": "bootstrap/runtime-bundle/git",
        "to": "runtime/bundled/git"
      },
      {
        "from": "bootstrap/runtime-bundle/python",
        "to": "runtime/bundled/python"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "dir",
        "nsis"
      ],
      "icon": "assets/mindspace-icon.ico",
      "executableName": "Mindspace",
      "artifactName": "Mindspace-${version}-${arch}-offline.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://douyinqijun.cn/downloads/mindspace/launcher/stable/"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mindspace",
      "installerIcon": "assets/mindspace-icon.ico",
      "uninstallerIcon": "assets/mindspace-icon.ico",
      "include": "build/installer.nsh"
    }
  }
}
