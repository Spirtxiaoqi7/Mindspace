# Python environments and caches
.venv/
.venv-*/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# JavaScript dependencies and build output
**/node_modules/
**/.builder-cache/
*.tsbuildinfo
frontend/dist/
desktop/dist/

# Product build and packaging output
dist/
dist-*/
build/
artifacts/
backups/
desktop/bootstrap/
*.zip
*.exe
*.blockmap

# The NSIS policy is source code even though electron-builder keeps it below a
# directory named build. Keep generated files ignored and track only the
# reviewed installer include.
!desktop/build/
desktop/build/*
!desktop/build/installer.nsh

# Runtime state, downloads, logs, signing keys and user data
runtime/
logs/
.env
.env.*
!.env.example
*.log
*.partial

# Models and local voice material are distributed separately
assets/models/
assets/audio/**/*.wav
# Local reports and real-provider evidence are never release inputs.
reports/
.real-api-*/
.real-api-*
.runtime-*/
.runtime-*
.test-tmp/
.test-tmp*/
.tmp/
.tmp*/
visual-regression/
visual-artifacts/
deployment-tmp/
release-staging/
artifacts/
runtime/
.deploy-*/
.venv-*/
dist-launcher*/

# Production outputs and bootstrap payloads are generated locally.
src/mindspace_graph/web/assets/*.map
src/mindspace_graph/web/*.map

# Locally sealed, user-authorized R18 source material.  The encrypted resource
# is intentionally available to local packaging but is never committed.
src/mindspace_graph/resources/r18-private-library.bin

# CosyVoice is pinned as a Git submodule rather than vendored into this repository
vendor/CosyVoice/

# IDE and operating-system metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
# Live2D remains a V1.0 preview in 0.8.0. Keep SDK, renderer builds and model
# sources local until licensing and public-delivery gates are explicitly cleared.
desktop/companion/
desktop/assets/live2d/
desktop/assets/companion-renderer/

# Brand production intermediates are reproducible; retain only the approved
# transparent master, normalized asset and packaged ICO in source control.
desktop/assets/brand/mindspace-icon-chroma-v1.png
desktop/assets/brand/mindspace-icon-preview-*.png
